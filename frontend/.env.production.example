# FleetMind Production Environment Variables
# Use this template when configuring environment variables on Vercel / Netlify.
#
# DO NOT commit secret keys (like Supabase Service Role Keys) here.
# All variables starting with NEXT_PUBLIC_ are exposed to the browser.

# ─────────────────────────────────────────────────────────────────────────────
# Supabase Production Config (Frontend Public Key)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key-here

# ─────────────────────────────────────────────────────────────────────────────
# Backend API URL (Production FastAPI Endpoint)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.fleetmind.com
