# FleetMind Frontend Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.
#
# .env.local is automatically gitignored by Next.js.

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — FRONTEND / PUBLIC (safe to expose to browser)
# ─────────────────────────────────────────────────────────────────────────────
# These use the PUBLIC anon key, which is safe to expose.
# It is NOT the service-role key.
#
# Found at: Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─────────────────────────────────────────────────────────────────────────────
# Backend API URL
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_API_URL=http://localhost:8000
