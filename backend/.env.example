# FleetMind Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to source control.

# ─────────────────────────────────────────────────────────────────────────────
# AI / Tool API Keys
# ─────────────────────────────────────────────────────────────────────────────

# Nebius Token Factory (get from: https://tokenfactory.nebius.com)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Tavily (get from: https://tavily.com)
TAVILY_API_KEY=tvly-your_key_here

# mem0 (get from: https://mem0.ai)
MEM0_API_KEY=your_mem0_api_key_here

# Composio (get from: https://composio.dev)
COMPOSIO_API_KEY=your_composio_api_key_here

# Optional: GitHub repo for issue creation
GITHUB_REPO=yourusername/yourrepo

# ─────────────────────────────────────────────────────────────────────────────
# Supabase Authentication & Database — BACKEND / SERVER-SIDE ONLY
# These values MUST NOT be exposed to the browser or frontend.
# ─────────────────────────────────────────────────────────────────────────────

# Your Supabase project URL (e.g. https://abcdefghij.supabase.co)
# Found at: Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# JWT Secret for verifying user JWTs (HS256).
# Found at: Supabase Dashboard → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Service Role Key for workspace-scoped database & storage operations
# Found at: Supabase Dashboard → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ─────────────────────────────────────────────────────────────────────────────
# Stripe Billing — BACKEND / SERVER-SIDE ONLY
# ─────────────────────────────────────────────────────────────────────────────

# Stripe Secret API Key (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Webhook Signing Secret (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# ─────────────────────────────────────────────────────────────────────────────
# CORS — configure allowed frontend origins
# ─────────────────────────────────────────────────────────────────────────────

# Comma-separated list of frontend origins that may send credentialed requests.
# For local development: http://localhost:3000
# For production: add your deployed frontend URL (e.g. https://app.fleetmind.com).
ALLOWED_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# App settings
# ─────────────────────────────────────────────────────────────────────────────

PORT=8000
ENVIRONMENT=development
