# FleetMind Environment Variables
# Copy this to .env and fill in your credentials

# Nebius AI (get from: https://studio.nebius.ai)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# Tavily (get from: https://tavily.com — code: TVLY-7CCN692Z)
TAVILY_API_KEY=tvly-your_key_here

# mem0 (get from: https://mem0.ai — code: SHIPBUILDERS)
MEM0_API_KEY=your_mem0_api_key_here

# Composio (get from: https://composio.dev — code: SHIP_BUILDERS)
COMPOSIO_API_KEY=your_composio_api_key_here

# Optional: GitHub repo for issue creation
GITHUB_REPO=yourusername/yourrepo

# App settings
PORT=8000
ENVIRONMENT=development
